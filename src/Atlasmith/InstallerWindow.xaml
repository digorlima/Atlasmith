<Window x:Class="Atlasmith.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atlasmith"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Window}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ BARRA DE TÍTULO ============================ -->
        <Grid Grid.Row="0" Background="{DynamicResource Brush.Surface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6"
                        Background="{DynamicResource Brush.AccentGradient}">
                    <Path Fill="White" Stretch="Uniform" Margin="5"
                          Data="M0,0 H5 V7 H0 Z M6,0 H12 V3 H6 Z M6,4 H12 V7 H6 Z" />
                </Border>
                <TextBlock Text="Atlasmith" Style="{StaticResource Text.Title}"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="5"
                        Padding="6,2" Margin="9,1,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionBadge" Text="1.0" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Accent}" />
                </Border>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Close}"
                    Content="{StaticResource Icon.Close}"
                    ToolTip="{DynamicResource T.CloseWindow}"
                    Click="OnCancel" />
        </Grid>

        <!-- ============================ CONTEÚDO ============================ -->
        <StackPanel Grid.Row="1" Margin="24,22,24,22">
            <TextBlock x:Name="HeadingText"
                       Style="{StaticResource Text.Title}"
                       FontSize="20" />
            <TextBlock Text="{DynamicResource T.InstallIntro}"
                       Style="{StaticResource Text.Hint}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource T.InstallLocation}"
                               Style="{StaticResource Text.Label}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LocationText"
                               Style="{StaticResource Text.Base}"
                               FontFamily="{StaticResource Font.Mono}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,5,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource T.DesktopShortcut}" Style="{StaticResource Text.Base}"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="DesktopToggle" Grid.Column="1"
                                  Style="{StaticResource CheckBox.Toggle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource T.StartMenuShortcut}" Style="{StaticResource Text.Base}"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="StartMenuToggle" Grid.Column="1"
                                  Style="{StaticResource CheckBox.Toggle}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource T.LaunchAfterInstall}" Style="{StaticResource Text.Base}"
                                   VerticalAlignment="Center" />
                        <CheckBox x:Name="LaunchToggle" Grid.Column="1" IsChecked="True"
                                  Style="{StaticResource CheckBox.Toggle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText"
                       Style="{StaticResource Text.Hint}"
                       TextWrapping="Wrap"
                       Margin="2,14,2,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource T.Cancel}"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="OnCancel" />
                <Button x:Name="InstallButton"
                        Style="{StaticResource Button.Primary}"
                        MinWidth="128"
                        IsDefault="True"
                        Click="OnInstall" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
