<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window" Color="#12131A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1A1C25" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#21242F" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#2A2E3C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2C3040" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3B4054" />

    <SolidColorBrush x:Key="Brush.Text" Color="#ECEEF5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A2A9BC" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E7689" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#7A5CFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8D74FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#6A4CEE" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#241F4A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#3ECF8E" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#F5A524" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FF5A66" />

    <SolidColorBrush x:Key="Brush.CheckerA" Color="#20222C" />
    <SolidColorBrush x:Key="Brush.CheckerB" Color="#191B23" />
    <SolidColorBrush x:Key="Brush.SpriteOutline" Color="#557A5CFF" />
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#E5484D" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7A5CFF" Offset="0" />
        <GradientStop Color="#4C8DFF" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="Color.Shadow">#000000</Color>

</ResourceDictionary>
