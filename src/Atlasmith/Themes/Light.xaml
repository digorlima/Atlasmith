<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window" Color="#F2F3F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F7F8FC" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#ECEEF6" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E2E5EF" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CBD0DF" />

    <SolidColorBrush x:Key="Brush.Text" Color="#14161D" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5A6275" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A91A3" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#6244EE" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#7358FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#5236D8" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#EDE9FF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Success" Color="#12A46B" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B7791F" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2B37" />

    <SolidColorBrush x:Key="Brush.CheckerA" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CheckerB" Color="#E9EBF2" />
    <SolidColorBrush x:Key="Brush.SpriteOutline" Color="#556244EE" />
    <SolidColorBrush x:Key="Brush.CloseHover" Color="#E5484D" />

    <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6244EE" Offset="0" />
        <GradientStop Color="#2F80ED" Offset="1" />
    </LinearGradientBrush>

    <Color x:Key="Color.Shadow">#8A94AD</Color>

</ResourceDictionary>
