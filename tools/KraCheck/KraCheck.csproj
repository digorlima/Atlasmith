<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KraCheck</RootNamespace>
    <AssemblyName>KraCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- O mesmo núcleo do app e do pacote do Unity; do app, só o leitor de imagens. -->
    <ProjectReference Include="..\..\src\Atlasmith.Core\Atlasmith.Core.csproj" />
    <Compile Include="..\..\src\Atlasmith\Services\ImageLoader.cs" Link="App\ImageLoader.cs" />
    <Compile Include="..\..\src\Atlasmith\Services\TgaDecoder.cs" Link="App\TgaDecoder.cs" />
  </ItemGroup>

</Project>
